{
  "manifest_version": 3,
  "minimum_chrome_version": "110",
  "name": "ANP Wallet",
  "version": "0.1.0",
  "description": "ANP Agent Network Protocol did:wba wallet — ANP-03 HTTP Message Signatures (RFC 9421).",
  "action": {
    "default_title": "ANP Wallet"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": ["storage", "clipboardWrite", "sidePanel"],
  "host_permissions": ["https://awiki.ai/*"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
